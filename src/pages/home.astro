---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";

const products = [
  { name: "Abrigo largo pliegue espalda", price: 59.99, image: "/images/articulo1.png" },
  { name: "Abrigo largo pliegue pecho", price: 59.99, image: "/images/articulo2.png" },
  { name: "Abrigo acolchado extralargo", price: 49.99, image: "/images/articulo1.png" },
  { name: "Gabardina vaquera", price: 69.99, image: "/images/articulo2.png" },
  { name: "Abrigo paño", price: 29.99, image: "/images/articulo1.png" },
  { name: "Abrigo acolchado capucha", price: 49.99, image: "/images/articulo2.png" },
  { name: "Abrigo borreguillo", price: 19.99, image: "/images/articulo1.png" },
  { name: "Jeans skinny rotos", price: 9.99, image: "/images/articulo2.png" },
];
---
<Layout title="Home | Clothing Store">
  <main class="home">

    <header class="hero">
      <img src="/images/Home.png" alt="Modelo de la campaña de rebajas" class="hero__image" />

      <nav class="navbar">
        <ul class="navbar__links">
          <li><a href="/home" class="active">HOME</a></li>
          <li><a href="/shop">SHOP</a></li>
        </ul>
        <a href="/user" class="navbar__user">
          <span>User_name</span>
          <img src="/images/6522581.png" alt="Avatar del usuario" />
        </a>
      </nav>

      <div class="hero__content">
        <h1>REBAJAS</h1>
        <p class="hero__subtitle">MIRTO MUJER</p>
        <p class="hero__discounts">-10% -20% -30% -40% -50%</p>
      </div>
    </header>

    <section class="toolbar">
      <img src="/images/Marca.png" alt="Clothing Store" class="toolbar__logo" />
      <div class="toolbar__search">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="2" />
          <line x1="15" y1="15" x2="21" y2="21" stroke="currentColor" stroke-width="2" />
        </svg>
        <input type="search" placeholder="BUSCAR" aria-label="Buscar" />
      </div>
    </section>

    <section class="products">
      {products.map((product) => (
        <ProductCard name={product.name} price={product.price} image={product.image} />
      ))}
    </section>

  </main>
</Layout>

<style>
  .hero {
    position: relative;               
    width: 100%;
    aspect-ratio: 582 / 378;         
    min-height: 420px;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;                         
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;             
    filter: grayscale(1);             
  }


  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    z-index: 1;                       
  }

  .navbar__links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
  }

  .navbar a {
    text-decoration: none;
    color: #333;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .navbar__links a.active {
    border-bottom: 2px solid #333;
    padding-bottom: 2px;
  }

  .navbar__user {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .navbar__user img {
    width: 36px;
    height: 36px;
    border-radius: 50%;               
    object-fit: cover;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;       
    align-items: center;
    padding-bottom: 2.5rem;
    color: white;
    text-align: center;
  }

  .hero__content h1 {
    font-size: clamp(3rem, 8vw, 5rem);  
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 300;
    font-style: italic;
    margin: 0.5rem 0 1.5rem;
  }

  .hero__discounts {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 300;
    word-spacing: 0.3em;
  }

  .toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;  
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .toolbar__logo {
    grid-column: 2;                   
    width: 100px;
  }

  .toolbar__search {
    grid-column: 3;
    justify-self: end;                
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 200px;
    padding: 0.4rem 0.6rem;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  .toolbar__search input {
    flex: 1;                          
    min-width: 0;
    border: none;
    outline: none;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
  }


  .products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem 1rem;                   
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  @media (max-width: 800px) {
    .products { grid-template-columns: repeat(2, 1fr); }
  }
</style>